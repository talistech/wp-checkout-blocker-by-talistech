{
  "name": "talistech/wp-checkout-blocker-by-talistech",
  "description": "Checkout Blocker by Talistech.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Talistech",
      "homepage": "https://www.talistech.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Talistech\\CheckoutBlocker\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Talistech\\CheckoutBlocker\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "lint": "phpcs",
    "build": "python3 bin/build-release.py"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.1.0"
    }
  }
}
