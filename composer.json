{
  "name": "talistech/wp-checkout-blocker-by-talistech",
  "description": "Checkout Blocker by Talistech for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Talistech\\CheckoutBlocker\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Talistech\\CheckoutBlocker\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  }
}
